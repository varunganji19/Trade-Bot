# Copy to `.env` (never commit .env) and fill what you need.
# EVERY var is optional — with none of them the bot runs fully deterministic
# ("quant mode") on paper, which is the shipped default.

# --- LLM (optional: headline sentiment scoring, tie-breaker/veto, chatbot) ---
# Exactly one key enables the LLM layer; model auto-detects per provider.
OPENAI_API_KEY=
# OPENAI_BASE_URL=            # OpenAI-compatible endpoint override
# ANTHROPIC_API_KEY=
# LLM_MODEL=gpt-4o-mini       # default per provider

# --- Dashboard -------------------------------------------------------------
# Bearer token required on every API request when set. The HTML page shell
# loads unguarded (no secrets in it) and the browser UI prompts once for the
# token, remembering it in localStorage. Keep the dashboard on 127.0.0.1;
# this is the belt-and-suspenders layer if you ever expose it.
DASHBOARD_TOKEN=
# Set to 1 to stop the engine auto-resuming on dashboard boot (e.g. on a
# rehearsal machine that must not trade without you clicking Start).
# ALGO_NO_AUTO_RESUME=1

# --- Account / engine --------------------------------------------------------
PAPER_CAPITAL=10000
LIVE_INTERVAL=60

# --- Portfolio allocator -----------------------------------------------------
PORTFOLIO_ALLOC=1
PORTFOLIO_METHOD=inverse_vol   # inverse_vol | hrp | equal

# --- Cost model ---------------------------------------------------------------
# 1 = bracket take-profits price as resting limits (maker fee, no slippage);
# 0 = the kill switch for that model (everything pays taker + slippage).
MAKER_PRICING=1

# --- HFT book (1m paper account; see HFT.md) ----------------------------------
# HFT_ENABLED=1
# HFT_PAPER_CAPITAL=10000
# HFT_INTERVAL=2              # seconds between HFT engine cycles (paper; API floor 1s)
# HFT_PENETRATION_BPS=0.0     # maker-fill realism: bps of penetration before a resting limit fills
# HFT_FEE_TIER=perp           # perp (taker 5bp/maker 2bp/slippage 3bp) | spot (base tier)

# --- Kronos forecast model (optional; needs requirements-kronos.txt) ---------
KRONOS_MODEL=NeoQuasar/Kronos-small
KRONOS_TOKENIZER=NeoQuasar/Kronos-Tokenizer-base

# --- Journal location (defaults to data/trading.db) ---------------------------
# BOT_DB_PATH=data/trading.db

# rolling backtest-cache freshness bound in HOURS (default 24; 0 forces refetch)
#CACHE_FRESHNESS_HOURS=24
