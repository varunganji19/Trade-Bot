```gitignore
# Compiled Python files
*.pyc
__pycache__/

# Virtual environments
venv/
.venv/
env/

# Logs
*.log

# Temporary files
*.tmp
*.swp

# Coverage reports
.coverage
coverage/
htmlcov/

# Environment files
.env
.env.local
*.env.*

# IDE specific
.vscode/
.idea/

# Build artifacts
build/
dist/
target/

# Dependencies cache
.mypy_cache/
.pytest_cache/
```