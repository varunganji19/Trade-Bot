#  committed, checkable artifact — see the Evidence tab)
data/trading.db*
data/trading.backup.*.db
data/bot.db
data/cache/
data/results/
data/kronos_ic.json

# safety-net snapshots and OS clutter
.backup/
.DS_Store
.ruff_cache/
.zcode/
data/watchlist.json
data/engine_state.json

# secrets — .env.example is the committed template; .env never leaves the machine
.env

# generated validation report (validate --report); regenerate any time
REPORT.md

# more runtime state + local scratch
data/hft_engine_state.json
data/market_mode.json
nvidia_test.py
